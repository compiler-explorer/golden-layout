{
  "name": "@compiler-explorer/golden-layout",
  "version": "1.6.2",
  "author": "deepstreamHub GmbH",
  "license": "MIT",
  "devDependencies": {
    "@types/jquery": "^3.5.30",
    "@vitest/browser-playwright": "^5.0.3",
    "handlebars": "^4.7.9",
    "less": "^4.9.1",
    "playwright": "^1.63.0",
    "typescript": "^6.0.3",
    "uglify-js": "^3.19.3",
    "vitest": "^5.0.3"
  },
  "description": "A multi-screen javascript Layout manager \r https://golden-layout.com",
  "main": "./dist/goldenlayout.js",
  "typings": "./index.d.ts",
  "directories": {
    "test": "test"
  },
  "dependencies": {
    "jquery": "*"
  },
  "scripts": {
    "build": "node build/build.js",
    "prepack": "npm run build",
    "test": "vitest run && npm run typecheck",
    "typecheck": "tsc -p tsconfig.json"
  },
  "files": [
    "dist",
    "src/css",
    "index.d.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/compiler-explorer/golden-layout.git"
  },
  "keywords": [
    "layout manager",
    "javascript",
    "docker",
    "layout",
    "popouts"
  ],
  "bugs": {
    "url": "https://github.com/compiler-explorer/golden-layout/issues"
  },
  "homepage": "https://github.com/compiler-explorer/golden-layout",
  "npmName": "golden-layout",
  "npmFileMap": [
    {
      "basePath": "/dist/",
      "files": [
        "goldenlayout.js",
        "goldenlayout.min.js"
      ]
    },
    {
      "basePath": "/src/css/",
      "files": [
        "goldenlayout.base.css",
        "goldenlayout-dark-theme.css",
        "goldenlayout-light-theme.css"
      ]
    },
    {
      "basePath": "/",
      "files": [
        "typings.json"
      ]
    }
  ],
  "jspm": {
    "main": "dist/goldenlayout",
    "format": "global",
    "registry": "jspm",
    "dependencies": {
      "jquery": "^2.1.0"
    },
    "shim": {
      "dist/goldenlayout": [
        "jquery"
      ]
    }
  }
}
